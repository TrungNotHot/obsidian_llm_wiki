{
  "$schema": "https://opencode.ai/config.json",
  "skills": [".agents/skills"],
  "mcp": {
    "servers": {
      "mcp_obsidian": {
        "type": "local",
        "command": ["uvx", "mcp-obsidian"],
        "environment": {
          "OBSIDIAN_API_KEY": "${OBSIDIAN_API_KEY}",
          "OBSIDIAN_HOST": "127.0.0.1",
          "OBSIDIAN_PORT": "27124"
        }
      }
    }
  }
}
